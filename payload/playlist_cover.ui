<ui>
  <string id="CFW_SET_PLAYLIST_PHOTO" text="Set Playlist Photo"/>
  <!-- Hold Center on a playlist, choose Set Playlist Photo: remember the playlist,
       then open Photos as the main menu does (Photos sets up its own image loading
       there); choose All Photos or an album, then a photo. -->
  <screen-event screen="MediaLists_Playlists_Screen"
                event="contextualMenu.CFW_SetPlaylistPhoto"
                handler="CFW_SetPlaylistPhoto"
                action="navigator.PushScreen"
                arguments="Photos_Screen, Photos_Menu"/>
  <!-- Playlists rows (ITEM 0x2e, also the Add to Playlist chooser's) drawn as the
       artwork row of Songs (ITEM 0x20): a larger image slot with the text moved
       over. Name in slot 1, song count in slot 10 (its second line, as in the stock
       Playlists row; slot 8 is not drawn), the icon or cover in 19 and 20
       (normal and highlighted), all from the Playlists model. -->
  <list-style item="0x2e" like="0x20" sources="1=0x781c 10=0x7821 19=0x781d 20=0x781e"/>
</ui>
